# ============================================================================
# Projeto Pikachu - Exemplo de Configuração
# ============================================================================
# Este arquivo é um TEMPLATE. Copie para `.env` e edite com seus valores.
# Uso
#   cp .env.example .env
#   # Edite .env com suas credenciais
# ============================================================================

# --- Configuração da Aplicação ---
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

# --- Banco de Dados ---
DATABASE_URL=postgresql://user:password@localhost:5432/pikachu
DATABASE_POOL_SIZE=10

# --- APIs Externas (substitua com valores reais) ---
OPENAI_API_KEY=sk-proj-EXAMPLE-KEY-DO-USE
ML_ACCESS_TOKEN=example_token_do_not_use
AWS_ACCESS_KEY_ID=AKIAEXAMPLEKEY
AWS_SECRET_ACCESS_KEY=example_secret_do_use

# --- Configuração de Logs ---
LOG_LEVEL=INFO
LOG_FILE=logs/pikachu.log

# --- Configuração de Testes ---
PYTEST_TIMEOUT=300
COVERAGE_THRESHOLD=80

