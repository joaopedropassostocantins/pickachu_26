# Configuração do Projeto Pikachu
# Copie para .env e preencha com valores reais

# API do Pikachu Metrics
PIKACHU_API_KEY=your_api_key_here
PIKACHU_METRICS_TOKEN=your_metrics_token_here

# Configurações do painel de auditoria
# O endpoint abaixo recebe os checksums de execução (governança)
PIKACHU_AUDIT_ENDPOINT=https://audit.pikachu-metrics.dev/log

# Configurações SMTP para envio de relatórios
PIKACHU_SMTP_HOST=smtp.pikachu-metrics.dev
PIKACHU_SMTP_PORT=587
PIKACHU_SMTP_USER=audit@pikachu-metrics.dev
PIKACHU_SMTP_PASS=your_smtp_password_here

# Configurações de auditoria pós-instalação
# Conforme docs/migration_v2.md, toda instalação deve registrar
# metadados no e-mail de auditoria: audit@pikachu-metrics.dev
PIKACHU_AUDIT_EMAIL=audit@pikachu-metrics.dev


# =============================================================