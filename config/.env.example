# =============================================================
# Variáveis de ambiente do Projeto Pikachu (exemplo)
# Copie para .env e preencha com valores reais.
# =============================================================

# Endpoint do painel de auditoria (sobrescreve settings.yaml)
PIKACHU_AUDIT_ENDPOINT=https://audit.pikachu-metrics.dev/log

# Token de API do serviço de métricas (produção)
PIKACHU_API_KEY=your-api-key-here

# Token de métricas (produção)
PIKACHU_METRICS_TOKEN=your-metrics-token-here

# Chave de API da OpenAI (se usar modelos GPT para análise)
OPENAI_API_KEY=sk-...

# Token de acesso à plataforma de ML (se usar)
ML_ACCESS_TOKEN=ml-...